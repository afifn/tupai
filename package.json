{
  "name": "db-manager",
  "productName": "Tupai",
  "version": "0.2.2",
  "description": "Tupai, a desktop multi-database management tool",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./out/main/index.js",
  "author": "Tupai",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/check-worker-bundle.mjs",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-rebuild -f -w better-sqlite3,oracledb",
    "rebuild:host": "electron-rebuild -f -w better-sqlite3,cpu-features",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "PYTHON=/usr/bin/python3 npm run build && PYTHON=/usr/bin/python3 electron-builder --mac --arm64 --x64 && npm run rebuild:host",
    "dist:mac:arm64": "PYTHON=/usr/bin/python3 npm run build && PYTHON=/usr/bin/python3 electron-builder --mac --arm64",
    "dist:mac:x64": "PYTHON=/usr/bin/python3 npm run build && PYTHON=/usr/bin/python3 electron-builder --mac --x64 && npm run rebuild:host",
    "dist:mac:unsigned": "PYTHON=/usr/bin/python3 npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false PYTHON=/usr/bin/python3 electron-builder --mac --arm64 --x64 && npm run rebuild:host",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:sqlite": "scripts/smoke/run.sh sqlite",
    "smoke:sync": "scripts/smoke/run.sh sync",
    "smoke:postgres": "scripts/smoke/run.sh postgres",
    "smoke:mysql": "scripts/smoke/run.sh mysql",
    "smoke:app": "scripts/smoke/run.sh app",
    "smoke:provision": "scripts/smoke/run.sh provision",
    "smoke:p1": "scripts/smoke/run.sh p1",
    "smoke:p1-app": "scripts/smoke/run.sh p1-app",
    "smoke:p2": "scripts/smoke/run.sh p2-cancel",
    "smoke:p2-ui": "scripts/smoke/run.sh p2-ui",
    "smoke:atomic": "scripts/smoke/run.sh atomic",
    "smoke:p2-ssh": "scripts/smoke/run.sh p2-ssh",
    "smoke:p2-ai": "scripts/smoke/run.sh p2-ai",
    "smoke:p2-preview": "scripts/smoke/run.sh p2-preview",
    "smoke:menu": "scripts/smoke/run.sh menu",
    "release:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false PYTHON=/usr/bin/python3 electron-builder --mac --arm64 --x64 --publish always && npm run rebuild:host",
    "release:win": "npm run build && electron-builder --win --publish always",
    "release:meta": "node scripts/release-meta.mjs",
    "release:notes": "node scripts/release-notes.mjs --write",
    "smoke:worker": "scripts/smoke/run.sh worker",
    "smoke:p2-tx": "scripts/smoke/run.sh p2-tx"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.11.2",
    "mongodb": "^6.10.0",
    "mysql2": "^3.11.3",
    "oracledb": "^6.6.0",
    "pg": "^8.13.1",
    "pg-cursor": "^2.22.1",
    "sql-formatter": "^15.9.0",
    "ssh2": "^1.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^4.2.1",
    "@monaco-editor/react": "^4.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.6",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.1",
    "monaco-editor": "^0.52.2",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "cpu-features@0.0.10": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true,
    "oracledb@6.6.0": true,
    "ssh2@1.17.0": true
  }
}
